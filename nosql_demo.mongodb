print("\n==============================");
print("MongoDB NoSQL Demo Loaded");
print("==============================");

print("\nDatabase: routepulse_nosql");
print("Collection: trip_documents");

print("\nTotal documents inserted:");
print(db.trip_documents.countDocuments());

print("\n==============================");
print("All trip documents");
print("==============================");
db.trip_documents.find().forEach(doc => printjson(doc));

print("\n==============================");
print("Filter Query 1: Trips tagged as commute");
print("==============================");
db.trip_documents.find(
  { tags: "commute" },
  {
    _id: 0,
    trip_id: 1,
    "user.full_name": 1,
    "device.device_name": 1,
    tags: 1,
    "summary.total_distance_km": 1
  }
).forEach(doc => printjson(doc));

print("\n==============================");
print("Filter Query 2: Trips longer than 3 km");
print("==============================");
db.trip_documents.find(
  { "summary.total_distance_km": { $gt: 3 } },
  {
    _id: 0,
    trip_id: 1,
    "user.full_name": 1,
    tags: 1,
    "summary.total_distance_km": 1
  }
).forEach(doc => printjson(doc));